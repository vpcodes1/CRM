# Memecoin Bot Configuration

# ========== Osnovna podešavanja ==========

# Prati ove tokene (odvojene zarezom)
# Primer: TOKEN_ADDRESSES=0x123...,0x456...
TOKEN_ADDRESSES=

# Interval provere u milisekundama (default: 60000 = 1 minut)
CHECK_INTERVAL=60000

# Prag za upozorenje o promeni cene (u procentima)
PRICE_CHANGE_ALERT_THRESHOLD=5

# Chain (ethereum, bsc, polygon, solana, itd.)
DEFAULT_CHAIN=solana

# ========== Auto-Discovery (Automatsko pronalaženje novih tokena) ==========

# Uključi automatsko pronalaženje novih tokena (true/false)
AUTO_DISCOVERY_ENABLED=false

# Interval za discovery proveru u milisekundama (default: 300000 = 5 minuta)
DISCOVERY_INTERVAL=300000

# Upit za pretragu novih tokena (solana, ethereum, meme, itd.)
DISCOVERY_SEARCH_QUERY=solana

# Minimum likvidnost u USD (za sigurnost protiv scam tokena)
MIN_LIQUIDITY=5000

# Minimum 24h volumen u USD
MIN_VOLUME_24H=1000

# Maksimalna starost tokena u satima (za pronalaženje novih tokena)
# Za ultra-nove tokene (najrizičnije ali najviše profita): 1
# Za nove tokene: 6-12
# Za relativno nove: 24
MAX_TOKEN_AGE_HOURS=1
